{
  "schema_version": 1,
  "seed": 42,
  "stage": "pretrain",
  "model": {
    "vocab_size": 512,
    "layers": 1,
    "width": 32,
    "heads": 4,
    "feedforward": 64,
    "context": 32,
    "dropout": 0.2
  },
  "data": {
    "format": "reviewed-documents-v1",
    "max_document_characters": 2000000
  },
  "training": {
    "batch_size": 2,
    "gradient_accumulation": 2,
    "max_steps": 4,
    "schedule_steps": 8,
    "max_tokens": 0,
    "warmup_steps": 1,
    "learning_rate": 0.001,
    "weight_decay": 0.1,
    "gradient_clip": 1.0,
    "validate_every": 2,
    "save_every": 2,
    "validation_tokens": 64
  },
  "scoring": {
    "batch_size": 4,
    "max_candidates": 4,
    "length_penalty": 1.0,
    "context_tokens": 8,
    "candidate_tokens": 8
  },
  "distillation": {
    "temperature": 2.0,
    "kd_weight": 1.0,
    "lm_weight": 0.2,
    "label_weight": 0.0,
    "validation_pools": 8
  }
}
