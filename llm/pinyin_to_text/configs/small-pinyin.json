{
  "schema_version": 1,
  "seed": 42,
  "model": {
    "vocab_size": 8192,
    "d_model": 384,
    "nhead": 8,
    "encoder_layers": 4,
    "decoder_layers": 4,
    "dim_feedforward": 1536,
    "dropout": 0.1,
    "max_source_tokens": 48,
    "max_target_tokens": 16
  },
  "data": {
    "format": "static-csv"
  },
  "training": {
    "batch_size": 16,
    "gradient_accumulation": 1,
    "max_steps": 2000,
    "schedule_steps": 2000,
    "warmup_steps": 50,
    "learning_rate": 0.0003,
    "weight_decay": 0.01,
    "gradient_clip": 1.0,
    "validate_every": 100,
    "save_every": 100,
    "precision": "fp32",
    "activation_checkpointing": false
  },
  "decoding": {
    "beam_size": 5,
    "length_penalty": 0.6
  }
}
